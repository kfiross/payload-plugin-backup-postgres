{
  "name": "payload-plugin-backup-postgres",
  "version": "0.1.0",
  "description": "Payload CMS plugin for PostgreSQL backup and recovery via Vercel Blob or AWS S3 (S3-compatible: R2, MinIO)",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-cms",
    "payload-plugin",
    "payloadcms-plugin",
    "payload-backup",
    "payload-restore",
    "backup",
    "restore",
    "recovery",
    "database-backup",
    "cms-backup",
    "vercel",
    "vercel-blob",
    "cron",
    "scheduled-backups",
    "admin-dashboard",
    "nextjs",
    "react",
    "typescript",
    "payblocks",
    "postgres",
    "postgresql",
    "drizzle"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "import": "./dist/exports/rsc.js",
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    },
    "./styles.css": "./dist/backup-dashboard.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "release": "bun run build && changeset publish",
    "build": "pnpm copyfiles && pnpm build:css && pnpm build:embed-css && pnpm build:types && pnpm build:swc && pnpm build:esm-ext",
    "build:css": "sass src/components/BackupDashboard/index.scss dist/backup-dashboard.css --no-source-map --pkg-importer=node --quiet-deps --silence-deprecation=import",
    "build:embed-css": "node ./scripts/embed-backup-css.mjs",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "format": "prettier --write . --cache --log-level warn",
    "format:check": "prettier --check . --cache --log-level warn",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --fix",
    "test": "vitest run",
    "test:int": "vitest run",
    "test:int:cov": "vitest run --coverage",
    "test:int:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:esm-ext": "node ./scripts/fix-esm-extensions.mjs dist"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "cronstrue": "^3.14.0",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/translations": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "@swc/cli": "0.6.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/tar-stream": "^3.1.4",
    "@vitest/coverage-v8": "^4.1.5",
    "copyfiles": "2.4.1",
    "eslint": "^9.23.0",
    "payload": "3.82.1",
    "prettier": "^3.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rimraf": "3.0.2",
    "sass": "^1.85.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.5",
    "@payloadcms/db-postgres": "3.82.1",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.10",
    "next": "16.2.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@payloadcms/ui": "^3.0.0",
    "next": "^15.0.0 || ^16.0.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "@payloadcms/db-postgres": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@payloadcms/db-postgres": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      },
      "./rsc": {
        "import": "./dist/exports/rsc.js",
        "types": "./dist/exports/rsc.d.ts",
        "default": "./dist/exports/rsc.js"
      },
      "./styles.css": "./dist/backup-dashboard.css"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
